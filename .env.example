# Copy this file to .env and fill in real values. .env is git-ignored.
#
# Used two ways:
#   - Running the jar directly: every key below is read by Utils.loadConfig().
#   - Running via `docker compose up`: NAS_ROOT/TEMP_DIR/FFMPEG_BIN/FFPROBE_BIN
#     are overridden inside the container by docker-compose.yml (baked-in
#     Linux paths), so only NAS_HOST/NAS_SHARE/NAS_USER/NAS_PASS and
#     SCAN_INTERVAL_MINUTES actually matter for Docker. Real env vars (e.g.
#     `docker run -e`) always take precedence over whatever is in this file.

# Filesystem paths — optional when running the jar directly. If unset, the
# app falls back to OS-detected defaults (see Utils.java: buildPathConfig).
# The re-encoded file is written back over the original at NAS_ROOT via this
# same mounted path, so it must be writable, not just readable.
NAS_ROOT=NAS-Root
TEMP_DIR=C:\Temp\nas\
FFMPEG_BIN=.\ffmpeg\ffmpeg.exe
FFPROBE_BIN=.\ffmpeg\ffprobe.exe

# Docker Compose only (not read by the app itself) — used by the `nas-data`
# CIFS volume in docker-compose.yml, which mounts //NAS_HOST/NAS_SHARE
# directly at the Docker daemon level and presents it to the container as
# /nas. This is why NAS_HOST/etc. exist separately from NAS_ROOT above: the
# container never sees your Windows drive letter, it connects to the SMB
# share itself. Needs cifs-utils (mount.cifs) available wherever the Docker
# daemon runs — on Docker Desktop for Windows that's inside its WSL2 VM, not
# your Windows host, so this is worth confirming works before relying on it.
# Note: these credentials end up visible in plaintext via `docker volume
# inspect nas-data` to anyone with Docker access on the host.
NAS_HOST=NAS-IP
NAS_SHARE=MediaPath
NAS_USER=nasuser
NAS_PASS=changeme

# How often (in minutes) a full scan-and-process cycle runs. Optional, default 10.
SCAN_INTERVAL_MINUTES=10
